{
  "manifest_version": 1,
  "type": "device",
  "name": "Frisquet Connect",
  "description": {
    "en": "Frisquet boilers with the Connect box: zones, setpoints, modes, hot water, alarms and gas use.",
    "fr": "Chaudières Frisquet avec box Connect : zones, consignes, modes, eau chaude, alarmes et gaz consommé.",
    "de": "Frisquet-Heizkessel mit Connect-Box: Zonen, Sollwerte, Modi, Warmwasser, Alarme und Gasverbrauch.",
    "es": "Calderas Frisquet con caja Connect: zonas, consignas, modos, agua caliente, alarmas y gas."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-frisquet:1.0.0",
  "gladys_version": ">=5.2.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-frisquet/main/cover.png",
  "categories": ["climate", "energy"],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Frisquet Connect account",
        "fr": "Compte Frisquet Connect",
        "de": "Frisquet-Connect-Konto",
        "es": "Cuenta Frisquet Connect"
      },
      "description": {
        "en": "Use the e-mail and password of the Frisquet Connect app. The boiler needs the Frisquet Connect box. The cloud relays the boiler every few minutes: a change takes up to 5 minutes to show. Not affiliated with Frisquet.",
        "fr": "Utilisez l'e-mail et le mot de passe de l'appli Frisquet Connect. La chaudière doit être équipée de la box Frisquet Connect. Le cloud relaie la chaudière toutes les quelques minutes : un changement met jusqu'à 5 minutes à apparaître. Sans lien avec Frisquet.",
        "de": "Verwende die E-Mail-Adresse und das Passwort der App Frisquet Connect. Der Heizkessel braucht die Frisquet-Connect-Box. Die Cloud gibt den Kessel alle paar Minuten weiter: Eine Änderung braucht bis zu 5 Minuten. Nicht mit Frisquet verbunden.",
        "es": "Utilice el correo electrónico y la contraseña de la aplicación Frisquet Connect. La caldera necesita la caja Frisquet Connect. La nube transmite la caldera cada pocos minutos: un cambio tarda hasta 5 minutos en verse. Sin relación con Frisquet."
      },
      "links": [
        {
          "url": "https://www.frisquet.com/fr/frisquet-connect_9.html",
          "label": {
            "en": "Frisquet Connect",
            "fr": "Frisquet Connect",
            "de": "Frisquet Connect",
            "es": "Frisquet Connect"
          }
        }
      ]
    },
    {
      "key": "email",
      "type": "string",
      "label": {
        "en": "E-mail",
        "fr": "E-mail",
        "de": "E-Mail-Adresse",
        "es": "Correo electrónico"
      },
      "description": {
        "en": "The e-mail you sign in to the Frisquet Connect app with.",
        "fr": "L'e-mail de connexion à l'appli Frisquet Connect.",
        "de": "Die E-Mail-Adresse, mit der du dich in der App Frisquet Connect anmeldest.",
        "es": "El correo electrónico con el que inicia sesión en la aplicación Frisquet Connect."
      },
      "placeholder": {
        "en": "e.g. name@example.com",
        "fr": "ex. nom@exemple.fr",
        "de": "z. B. name@example.com",
        "es": "p. ej. nombre@ejemplo.com"
      },
      "required": true
    },
    {
      "key": "password",
      "type": "secret",
      "label": {
        "en": "Password",
        "fr": "Mot de passe",
        "de": "Passwort",
        "es": "Contraseña"
      },
      "description": {
        "en": "Stored by Gladys, sent only to Frisquet Connect.",
        "fr": "Conservé par Gladys, envoyé seulement à Frisquet Connect.",
        "de": "Von Gladys gespeichert, nur an Frisquet Connect gesendet.",
        "es": "Guardada por Gladys, enviada solo a Frisquet Connect."
      },
      "required": true
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the names",
        "fr": "Langue des noms",
        "de": "Sprache der Namen",
        "es": "Idioma de los nombres"
      },
      "description": {
        "en": "Language of the feature names (fixed when a device is added) and of the texts of the integration.",
        "fr": "Langue des noms de fonctionnalités (figés à l'ajout d'un appareil) et des textes de l'intégration.",
        "de": "Sprache der Funktionsnamen (beim Hinzufügen eines Geräts festgelegt) und der Texte der Integration.",
        "es": "Idioma de los nombres de las funciones (fijados al añadir un dispositivo) y de los textos de la integración."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    },
    {
      "key": "poll_interval",
      "type": "select",
      "label": {
        "en": "Refresh interval",
        "fr": "Intervalle de relève",
        "de": "Abfrageintervall",
        "es": "Intervalo de lectura"
      },
      "description": {
        "en": "How often the boilers are read. The Connect box updates the cloud every few minutes: faster is useless.",
        "fr": "Fréquence de lecture des chaudières. La box Connect met à jour le cloud toutes les quelques minutes : plus vite ne sert à rien.",
        "de": "Wie oft die Heizkessel gelesen werden. Die Connect-Box aktualisiert die Cloud alle paar Minuten: schneller bringt nichts.",
        "es": "Frecuencia de lectura de las calderas. La caja Connect actualiza la nube cada pocos minutos: más rápido no sirve de nada."
      },
      "required": false,
      "default": "5",
      "options": [
        {
          "value": "5",
          "label": {
            "en": "5 minutes",
            "fr": "5 minutes",
            "de": "5 Minuten",
            "es": "5 minutos"
          }
        },
        {
          "value": "10",
          "label": {
            "en": "10 minutes",
            "fr": "10 minutes",
            "de": "10 Minuten",
            "es": "10 minutos"
          }
        },
        {
          "value": "15",
          "label": {
            "en": "15 minutes",
            "fr": "15 minutes",
            "de": "15 Minuten",
            "es": "15 minutos"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "timeout_seconds": 60
    }
  ],
  "scene_triggers": [
    {
      "key": "alarm_raised",
      "label": {
        "en": "Frisquet boiler alarm",
        "fr": "Alarme chaudière Frisquet",
        "de": "Alarm des Frisquet-Kessels",
        "es": "Alarma de la caldera Frisquet"
      },
      "description": {
        "en": "A new alarm appeared on the boiler (fault, Connect box disconnected...). The alarm text is a variable.",
        "fr": "Une nouvelle alarme est apparue sur la chaudière (défaut, box Connect déconnectée...). Son texte est une variable.",
        "de": "Ein neuer Alarm ist am Heizkessel aufgetreten (Störung, Connect-Box getrennt...). Der Alarmtext ist eine Variable.",
        "es": "Ha aparecido una nueva alarma en la caldera (fallo, caja Connect desconectada...). El texto es una variable."
      },
      "fields": [
        {
          "key": "boiler",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Boiler",
            "fr": "Chaudière",
            "de": "Heizkessel",
            "es": "Caldera"
          }
        }
      ],
      "variables": [
        {
          "key": "alarm",
          "type": "string",
          "label": {
            "en": "Alarm",
            "fr": "Alarme",
            "de": "Alarm",
            "es": "Alarma"
          }
        }
      ]
    }
  ],
  "scene_actions": [
    {
      "key": "set_zone_mode",
      "label": {
        "en": "Frisquet heating mode",
        "fr": "Mode de chauffage Frisquet",
        "de": "Frisquet-Heizmodus",
        "es": "Modo de calefacción Frisquet"
      },
      "description": {
        "en": "Set the mode of a zone, or of every zone of a boiler. Applied by the boiler within a few minutes.",
        "fr": "Change le mode d'une zone, ou de toutes les zones d'une chaudière. Appliqué sous quelques minutes.",
        "de": "Ändert den Modus einer Zone oder aller Zonen eines Heizkessels. Wird in wenigen Minuten übernommen.",
        "es": "Cambia el modo de una zona, o de todas las zonas de una caldera. Se aplica en unos minutos."
      },
      "timeout_seconds": 60,
      "fields": [
        {
          "key": "zone",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Zone or boiler",
            "fr": "Zone ou chaudière",
            "de": "Zone oder Heizkessel",
            "es": "Zona o caldera"
          },
          "required": true
        },
        {
          "key": "mode",
          "type": "select",
          "label": {
            "en": "Mode",
            "fr": "Mode",
            "de": "Modus",
            "es": "Modo"
          },
          "required": true,
          "options": [
            {
              "value": "auto",
              "label": {
                "en": "Back to the schedule",
                "fr": "Retour au programme",
                "de": "Zurück zum Zeitplan",
                "es": "Volver a la programación"
              }
            },
            {
              "value": "comfort",
              "label": {
                "en": "Comfort, permanent",
                "fr": "Confort permanent",
                "de": "Komfort, dauerhaft",
                "es": "Confort permanente"
              }
            },
            {
              "value": "reduced",
              "label": {
                "en": "Reduced, permanent",
                "fr": "Réduit permanent",
                "de": "Absenkung, dauerhaft",
                "es": "Reducido permanente"
              }
            },
            {
              "value": "frost",
              "label": {
                "en": "Frost protection, permanent",
                "fr": "Hors-gel permanent",
                "de": "Frostschutz, dauerhaft",
                "es": "Antihielo permanente"
              }
            },
            {
              "value": "comfort_override",
              "label": {
                "en": "Comfort until the next change",
                "fr": "Confort jusqu'au prochain changement",
                "de": "Komfort bis zur nächsten Änderung",
                "es": "Confort hasta el próximo cambio"
              }
            },
            {
              "value": "reduced_override",
              "label": {
                "en": "Reduced until the next change",
                "fr": "Réduit jusqu'au prochain changement",
                "de": "Absenkung bis zur nächsten Änderung",
                "es": "Reducido hasta el próximo cambio"
              }
            },
            {
              "value": "end_override",
              "label": {
                "en": "End the override",
                "fr": "Fin de la dérogation",
                "de": "Übersteuerung beenden",
                "es": "Fin de la derogación"
              }
            }
          ]
        }
      ],
      "outputs": [
        {
          "key": "mode",
          "type": "string",
          "label": {
            "en": "Mode requested",
            "fr": "Mode demandé",
            "de": "Angeforderter Modus",
            "es": "Modo solicitado"
          }
        }
      ]
    },
    {
      "key": "set_hot_water_mode",
      "label": {
        "en": "Frisquet hot water",
        "fr": "Eau chaude Frisquet",
        "de": "Frisquet-Warmwasser",
        "es": "Agua caliente Frisquet"
      },
      "description": {
        "en": "Set the hot water mode of a boiler. \"On\" restores the last mode used before \"Off\".",
        "fr": "Change le mode d'eau chaude d'une chaudière. « Marche » reprend le dernier mode utilisé avant « Arrêt ».",
        "de": "Ändert den Warmwassermodus eines Heizkessels. „Ein“ stellt den letzten Modus vor „Aus“ wieder her.",
        "es": "Cambia el modo de agua caliente de una caldera. «Encendido» recupera el último modo usado antes de «Apagado»."
      },
      "timeout_seconds": 60,
      "fields": [
        {
          "key": "boiler",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Boiler",
            "fr": "Chaudière",
            "de": "Heizkessel",
            "es": "Caldera"
          },
          "required": true
        },
        {
          "key": "mode",
          "type": "select",
          "label": {
            "en": "Mode",
            "fr": "Mode",
            "de": "Modus",
            "es": "Modo"
          },
          "required": true,
          "options": [
            {
              "value": "on",
              "label": {
                "en": "On (last mode)",
                "fr": "Marche (dernier mode)",
                "de": "Ein (letzter Modus)",
                "es": "Encendido (último modo)"
              }
            },
            {
              "value": "stop",
              "label": {
                "en": "Off",
                "fr": "Arrêt",
                "de": "Aus",
                "es": "Apagado"
              }
            },
            {
              "value": "max",
              "label": {
                "en": "MAX",
                "fr": "MAX",
                "de": "MAX",
                "es": "MAX"
              }
            },
            {
              "value": "eco",
              "label": {
                "en": "Eco",
                "fr": "Éco",
                "de": "Eco",
                "es": "Eco"
              }
            },
            {
              "value": "eco_timer",
              "label": {
                "en": "Eco, scheduled",
                "fr": "Éco programmé",
                "de": "Eco mit Zeitplan",
                "es": "Eco programado"
              }
            },
            {
              "value": "eco_plus",
              "label": {
                "en": "Eco+",
                "fr": "Éco+",
                "de": "Eco+",
                "es": "Eco+"
              }
            },
            {
              "value": "eco_plus_timer",
              "label": {
                "en": "Eco+, scheduled",
                "fr": "Éco+ programmé",
                "de": "Eco+ mit Zeitplan",
                "es": "Eco+ programado"
              }
            }
          ]
        }
      ],
      "outputs": [
        {
          "key": "mode",
          "type": "string",
          "label": {
            "en": "Mode requested",
            "fr": "Mode demandé",
            "de": "Angeforderter Modus",
            "es": "Modo solicitado"
          }
        }
      ]
    }
  ],
  "widgets": [
    {
      "key": "zones",
      "label": {
        "en": "Frisquet heating",
        "fr": "Chauffage Frisquet",
        "de": "Frisquet-Heizung",
        "es": "Calefacción Frisquet"
      },
      "description": {
        "en": "Heating zones: temperature, setpoint, mode, and buttons for programme, comfort, reduced, override.",
        "fr": "Zones de chauffage : température, consigne, mode, et boutons programme, confort, réduit, dérogation.",
        "de": "Heizzonen: Temperatur, Sollwert, Modus und Tasten für Zeitplan, Komfort, Absenkung, Übersteuerung.",
        "es": "Zonas: temperatura, consigna, modo y botones programación, confort, reducido, derogación."
      },
      "icon": "thermometer",
      "settings": [
        {
          "key": "zone",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Zone (empty: every zone)",
            "fr": "Zone (vide : toutes les zones)",
            "de": "Zone (leer: alle Zonen)",
            "es": "Zona (vacío: todas las zonas)"
          }
        }
      ],
      "action_timeout_seconds": 30
    }
  ]
}
